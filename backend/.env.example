# Copiar a .env y completar. El .env NO se sube al repo.
PORT=4000
NODE_ENV=development
# Connection string de Neon (Dashboard → Connect). Usar ?sslmode=verify-full (evita el warning de pg)
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origen del front (en dev, Vite)
CORS_ORIGIN=http://localhost:5173
